  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id        String  @id @default(cuid()) @map("_id")
  quote     String
  role      String
  place     String  @default("")
  published Boolean @default(true)
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid()) @map("_id")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([prefix])
}

model WebhookEndpoint {
  id         String            @id @default(cuid()) @map("_id")
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  events     String            @default("offer.created,offer.accepted,offer.declined,offer.countered")
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id         String          @id @default(cuid()) @map("_id")
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  status     Int             @default(0)
  detail     String          @default("")
  createdAt  DateTime        @default(now())

  @@index([endpointId])
}

model TapeDraft {
  token     String   @id @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model JobRun {
  id         String    @id @default(cuid()) @map("_id")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    String    @default("")
}

// One row per buyer each time the desk sends them a listing or a bid deadline.
model ListingSend {
  id        String   @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentById  String?
  // LISTING or DEADLINE
  kind      String
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([userId])
}

// Desk-only notes on a listing or closing. Never shown to a party.
model DeskNote {
  id          String   @id @default(cuid()) @map("_id")
  // listing or closing today; the action also accepts user
  subjectType String
  subjectId   String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([authorId])
}

model AuditEvent {
  id         String   @id @default(cuid()) @map("_id")
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}
