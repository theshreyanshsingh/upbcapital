generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  INDIVIDUAL_SELLER
  INSTITUTIONAL_SELLER
  BUYER
  ADMIN
  BROKER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanyType {
  BANK
  FUND
  SERVICER
  OTHER
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  CANCELED
  PAST_DUE
}

enum ListingKind {
  SINGLE
  POOL
}

enum ListingStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  PENDING
  SOLD
  // The seller took it off the book before a sale. Open bids are declined with it.
  WITHDRAWN
}

enum PropertyType {
  SFR
  CONDO
  TOWNHOUSE
  MULTIFAMILY
  LAND
  COMMERCIAL
  MIXED_USE
  OTHER
}

enum LienPosition {
  FIRST
  SECOND
  THIRD
  OTHER
}

enum PaymentStatus {
  PERFORMING
  NON_PERFORMING
  SUB_PERFORMING
}

enum Occupancy {
  OWNER_OCCUPIED
  TENANT
  VACANT
  UNKNOWN
}

enum ForeclosureStatus {
  NONE
  PRE_FORECLOSURE
  NOTICE_OF_DEFAULT
  LIS_PENDENS
  AUCTION_SCHEDULED
  REO
  UNKNOWN
}

enum DocType {
  NOTE
  MORTGAGE
  PAY_HISTORY
  BPO
  TITLE
  TAPE
  NDA
  OTHER
  // Collateral and third-party reports the desk files against one loan.
  ALLONGE
  ASSIGNMENT
  OE_REPORT
  RISK_SEARCH
  // A property photo the seller adds, shown on the listing to whoever may see the street address.
  PHOTO
  // A broker's signed mandate or listing agreement from the note holder, one per broker-filed listing.
  MANDATE
}

enum NdaMethod {
  TYPED
  DRAWN
  LEGACY
}

enum NoteTradeStatus {
  AVAILABLE
  IN_CONTRACT
  SOLD
}

enum VerificationStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum InvestorEntity {
  INDIVIDUAL
  LLC
  TRUST
  FUND
  OTHER
  // A self-directed IRA, held by a custodian for the buyer's benefit.
  IRA
}

enum OfferMessageKind {
  OFFER
  COUNTER
  NOTE
}

enum ClosingStatus {
  OPEN
  COMPLETE
  CANCELED
}

enum ClosingStepKey {
  PURCHASE_AGREEMENT
  BUYER_DEPOSIT
  COLLATERAL_TRANSFER
  ASSIGNMENT
  PAYMENT_RECEIVED
  CLOSED
}

enum ClosingStepStatus {
  PENDING
  COMPLETE
}

enum InquiryType {
  OFFER
  INFO_REQUEST
  DATA_ROOM
}

enum InquiryStatus {
  OPEN
  REVIEWED
  ACCEPTED
  DECLINED
  // The buyer took the bid back before an award, or its good-until date passed.
  WITHDRAWN
  EXPIRED
}

// One line of a loan's collateral file: the original note, each allonge and assignment in the chain, the
// mortgage, title and the desk's third-party reports.
enum CollateralKind {
  ORIGINAL_NOTE
  ALLONGE
  MORTGAGE
  ASSIGNMENT
  TITLE_POLICY
  OE_REPORT
  PAY_HISTORY
  BPO
}

// A difference between what the seller's tape says and what the desk read in a document. It stays open until the
// seller fixes the tape, explains it, or the desk accepts the document's value.
enum DiscrepancyStatus {
  OPEN
  FIXED
  EXPLAINED
  ACCEPTED
  WAIVED
}

enum CollateralStatus {
  PRESENT
  MISSING
  DEFECTIVE
  NOT_REQUIRED
}

// The checks a buyer would otherwise run alone: bankruptcy, property tax, other liens, pre-foreclosure and occupancy.
enum RiskKind {
  BANKRUPTCY
  TAX
  LIENS
  PRE_FORECLOSURE
  OCCUPANCY
  // The title snapshot: who holds the property on record against the borrower, and any recent deed transfer,
  // which is where deed fraud shows.
  VESTING
  DEED_TRANSFER
}

enum RiskResult {
  CLEAR
  FLAG
  UNKNOWN
}

enum ReviewAction {
  COMMENT
  UNDER_REVIEW
  APPROVE
  REJECT
  REQUEST_CHANGES
  MARK_PENDING
  MARK_SOLD
  EDIT
  WITHDRAW
  RESUBMIT
}

enum RevenueType {
  BUYER_PREMIUM
  SELLER_COMMISSION
  SUBSCRIPTION
  BROKER_FEE
}

enum BrokerDealRole {
  SELLER_BROKER
  AFFILIATE
}

enum FeeBasis {
  PERCENT
  FLAT
}

enum BrokerFeeStatus {
  OWED
  PAID
}

enum BidMode {
  NONE
  SEALED
  BEST_AND_FINAL
}

model User {
  id                           String             @id @default(cuid()) @map("_id")
  email                        String             @unique
  passwordHash                 String
  name                         String
  role                         Role
  accountStatus                AccountStatus      @default(PENDING)
  phone                        String             @default("")
  companyName                  String             @default("")
  companyType                  CompanyType?
  subscriptionTier             SubscriptionTier   @default(FREE)
  subscriptionStatus           SubscriptionStatus @default(INCOMPLETE)
  subscriptionComped           Boolean            @default(false)
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  subscriptionCurrentPeriodEnd DateTime?
  referralCode                 String?            @unique
  referredById                 String?
  referredBy                   User?              @relation("Referrals", fields: [referredById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals                    User[]             @relation("Referrals")
  referralCredits              Int                @default(0)
  referralRewarded             Boolean            @default(false)
  totpSecret                   String             @default("")
  totpEnabled                  Boolean            @default(false)
  recoveryHashes               String             @default("")
  recoveryReveal               String             @default("")
  emailOtpFallback             Boolean            @default(false)
  notifyEmail                  Boolean            @default(true)
  notifyInApp                  Boolean            @default(true)
  digest                       DigestFrequency    @default(WEEKLY)
  // The monthly note-market dispatch. Missing means not opted in.
  marketDispatch               Boolean?
  // Push notices to devices the user has installed the app on. Missing means off.
  pushEnabled                  Boolean?
  // Listings the desk sends by hand. Missing counts as on, so older accounts keep receiving them.
  dealAlerts                   Boolean?
  // Notices about listings the user saved: a new price, buy it now, a deadline, a withdrawal, new files, Q&A.
  // Missing counts as on.
  watchAlerts                  Boolean?
  // The weekly activity report a seller or broker gets on their live listings. Missing counts as on.
  sellerReport                 Boolean?
  lastSellerReportAt           DateTime?
  // The version of the terms of use and privacy policy the user accepted, and when. Missing means not yet.
  termsVersion                 String?
  termsAcceptedAt              DateTime?
  // For desk staff (role ADMIN): OWNER, SALES, CLOSINGS, COMPLIANCE, TRADER or ANALYST. Missing means OWNER, so
  // accounts from before roles keep every power. lib/staff.ts says what each may do.
  deskRole                     String?
  // Set when the account was deleted at the holder's request. Personal fields are cleared; deal records stay.
  deletedAt                    DateTime?
  // The desk member who created this account by invitation, and when.
  invitedById                  String?
  invitedAt                    DateTime?
  lastDigestAt                 DateTime?
  createdAt                    DateTime           @default(now())
  sessions                     ServerSession[]
  listings                     Listing[]
  inquiries                    Inquiry[]
  favorites                    Favorite[]
  ndas                         NdaAcknowledgment[]
  reviews                      ReviewComment[]
  savedSearches                SavedSearch[]
  buyerProfile                 BuyerProfile?
  sellerProfile                SellerProfile?
  offerMessages                OfferMessage[]
  notifications                Notification[]
  listingViews                 ListingView[]
  auditEvents                  AuditEvent[]
  buyBoxes                     BuyBox[]
  buyerHoldings                BuyerHolding[]
  groupsOpened                 GroupBuy[]       @relation("GroupsOpened")
  groupPositions               GroupPosition[]
  closingFunders               ClosingFunder[]
  apiKeys                      ApiKey[]
  webhooks                     WebhookEndpoint[]
  posts                        Post[]
  tapeDrafts                   TapeDraft[]
  threadSeats                  ThreadMember[]
  threadPosts                  ThreadPost[] @relation("ThreadAuthor")
  brokerProfile                BrokerProfile?
  brokeredListings             Listing[]          @relation("BrokeredListings")
  brokerFees                   BrokerFee[]
  listingSends                 ListingSend[]
  deskNotes                    DeskNote[]
  questionsAsked               ListingQuestion[] @relation("QuestionAsker")
  deletionRequests             DeletionRequest[]
  buyerEntities                BuyerEntity[]
  beneficialOwners             BeneficialOwner[]
  agreements                   AgreementAcceptance[]
}

model PlatformSettings {
  id                   String   @id @default("default") @map("_id")
  buyerPremiumBps      Int      @default(250)
  sellerCommissionBps  Int      @default(300)
  proMonthlyPriceCents Int      @default(24900)
  earlyAccessHours     Int      @default(48)
  freeBrowseLimit      Int      @default(4)
  stripeProductId      String   @default("")
  stripePriceId        String   @default("")
  wireInstructions     String   @default("")
  chargeDeskFees       Boolean  @default(true)
  retentionYears       Int      @default(7)
  brokerFeeBasis       FeeBasis @default(PERCENT)
  brokerFeeBps         Int      @default(2000)
  brokerFeeCents       Int      @default(50000)
  affiliateFeeBasis    FeeBasis @default(PERCENT)
  affiliateFeeBps      Int      @default(1000)
  affiliateFeeCents    Int      @default(25000)
  // Days from an accepted offer to the target close. Missing means the default in lib/closing-clock.ts.
  closingTargetDays    Int?
  // Deposit at award, as a share of the price, and the days the buyer has to wire it. Missing means the defaults.
  depositBps           Int?
  depositDays          Int?
  // Days after an award in which the buyer may walk away for a diligence finding. Missing or 0 means none.
  diligenceDays        Int?
  // The 10-year Treasury yield the desk last entered, for spread-based standing bids, and the day it was read.
  tenYearRate          Float?
  tenYearAsOf          DateTime?
  // The yield the book's indicative price on every listing is solved for. Missing means the default in lib/standing-bids.
  indicativeTargetYield Float?
  // The month of the last market dispatch sent, as YYYY-MM, so a month goes out once.
  lastDispatchMonth    String?
  // Weekdays closings settle on, as "TUE,THU", so the desk batches wires. Missing means any business day.
  settlementDays       String?
  // Strikes for failing to close before a buyer's bidding pauses for desk review. Missing means 2.
  strikeLimit          Int?
  // Two-step sign-in for every account that can see borrower data. Missing means on.
  requireTwoStep       Boolean?
  // The version of the terms of use and privacy policy every account must have accepted. The desk raises it when it
  // publishes a change that needs fresh consent. Missing means the version built into lib/legal.ts.
  legalVersion         String?
  // How the desk's document reader runs: OFF, SHADOW (findings go to the desk only, marked unconfirmed) or ON
  // (findings also open discrepancies for the desk to confirm). Missing means SHADOW. lib/ai-reading.ts.
  aiReading            String?
  // A graduated fee schedule, { tiers: [{ upTo, premiumBps, commissionBps }], minPremiumCents, minCommissionCents }.
  // Missing means the flat buyerPremiumBps and sellerCommissionBps above. lib/fee-schedule.ts reads it.
  feeSchedule          Json?
  // Where tenYearRate came from: MANUAL, or TREASURY when the job read it from Treasury's daily par yield curve.
  tenYearSource        String?
  // Whether a seller's identity and signing authority must be approved before the desk approves their listing.
  // Missing means on when UPB_RELEASE=1 and off in the demo. lib/seller-identity.ts reads it.
  requireSellerIdentity Boolean?
  // Hours from an award for every party to sign the purchase agreement. Missing means the default in lib/signatures.ts.
  psaSignHours         Int?
  // Days past the target close before an open closing is failed, or sent to the desk when money has moved.
  // Missing means the default in lib/backstop.ts.
  stallDays            Int?
  // Months a buyer's approved file stays current before the buyer must re-certify. Missing means 12.
  recertifyMonths      Int?
  updatedAt            DateTime @updatedAt
}

model BrokerProfile {
  userId             String    @id @map("_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            String    @default("")
  licenseType        String    @default("")
  licenseNumber      String    @default("")
  states             String    @default("")
  w9Key              String    @default("")
  w9Name             String    @default("")
  payoutNote         String    @default("")
  bio                String    @default("")
  portraitKey        String    @default("")
  welcomedAt         DateTime?
  brokerFeeBasis     FeeBasis?
  brokerFeeBps       Int?
  brokerFeeCents     Int?
  affiliateFeeBasis  FeeBasis?
  affiliateFeeBps    Int?
  affiliateFeeCents  Int?
  updatedAt          DateTime  @updatedAt
}

model BrokerFee {
  id          String          @id @default(cuid()) @map("_id")
  closingId   String
  closing     Closing         @relation(fields: [closingId], references: [id], onDelete: Cascade)
  brokerId    String
  broker      User            @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  role        BrokerDealRole
  amountCents Int
  basis       FeeBasis
  status      BrokerFeeStatus @default(OWED)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())

  @@unique([closingId, brokerId, role])
  @@index([status])
  @@index([brokerId])
}

model Listing {
  id                   String        @id @default(cuid()) @map("_id")
  kind                 ListingKind
  sellerId             String
  seller               User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status               ListingStatus @default(SUBMITTED)
  title                String
  summary              String        @default("")
  submittedAt          DateTime      @default(now())
  approvedAt           DateTime?
  soldAt               DateTime?
  salePrice            Float?
  buyerPremiumCents    Int?
  sellerCommissionCents Int?
  buyerTotalCents      Int?
  netToSellerCents     Int?
  acceptedInquiryId    String?
  brokerId             String?
  broker               User?         @relation("BrokeredListings", fields: [brokerId], references: [id], onDelete: SetNull)
  brokerRole           BrokerDealRole?
  clientSellerName     String        @default("")
  clientRelationship   String        @default("")
  authorizationKey     String        @default("")
  authorizationName    String        @default("")
  viewCount            Int           @default(0)
  bidMode              BidMode       @default(NONE)
  bidDeadline          DateTime?
  auctionNotifiedAt    DateTime?
  bidReminderAt        DateTime?
  // The seller's standing approval: a bid at or above this needs no further sign-off. Buyers never see it.
  reservePrice         Float?
  sellerFinanced       Boolean       @default(false)
  withdrawnAt          DateTime?
  // When the desk was told about this tape's standing bids. Set once, by whichever scoring run claims it.
  standingBidsNotifiedAt DateTime?
  // A price the seller has committed to sell at, to the first verified buyer who confirms it. Missing means none.
  buyNowPrice          Float?
  buyNowSetAt          DateTime?
  // The words the seller agreed to when setting it, kept as the record of their commitment.
  buyNowConsent        String?
  // The dated sale event this listing trades in, if any. The event sets its rounds.
  saleEventId          String?
  // The desk's fees as they stood when the listing went live, so a later change in settings doesn't reprice a
  // deal already marketed. Missing means the settings at award, for listings approved before this was kept.
  feeBuyerPremiumBps   Int?
  feeSellerCommissionBps Int?
  // The graduated schedule in force when the listing went live, when the desk used one. Wins over the flat fields.
  feeSchedule          Json?
  // The seller approves each bidder's data-room access after the NDA. Missing means the NDA alone opens it.
  roomApproval         Boolean?
  // The seller agreed to show this sale's anonymised result on the public results page.
  publishResult        Boolean?
  // When watchers were reminded of the bid deadline, so they hear once.
  watchReminderAt      DateTime?
  // The desk member who owns this deal, named to the seller as their contact.
  deskOwnerId          String?
  // An approved listing with a launch date shows on the book as coming soon until then: buyers can save it, but
  // the room, bids and alerts wait for the date. launchNotifiedAt is set once watchers hear it went live.
  launchAt             DateTime?
  launchNotifiedAt     DateTime?
  notes                Note[]
  documents            Document[]
  inquiries            Inquiry[]
  favorites            Favorite[]
  ndas                 NdaAcknowledgment[]
  reviews              ReviewComment[]
  closings             Closing[]
  groupBuys            GroupBuy[]
  views                ListingView[]
  matches              ListingMatch[]
  deskBids             DeskBid[]
  deskHoldings         DeskHolding[]
  sends                ListingSend[]
  questions            ListingQuestion[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([sellerId])
  @@index([brokerId])
  @@index([approvedAt])
  @@index([status, approvedAt])
}

model Note {
  id                String            @id @default(cuid()) @map("_id")
  listingId         String
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  streetAddress     String
  city              String
  state             String
  zip               String            @default("")
  propertyType      PropertyType
  occupancy         Occupancy         @default(UNKNOWN)
  estimatedValue    Float
  lienPosition      LienPosition
  upb               Float
  interestRate      Float
  monthlyPi         Float
  paymentStatus     PaymentStatus
  monthsDelinquent  Int               @default(0)
  lastPaidDate      DateTime?
  originationDate   DateTime?
  maturityDate      DateTime?
  askingPrice       Float
  foreclosureStatus ForeclosureStatus @default(NONE)
  borrowerName      String            @default("")
  memo              String            @default("")
  tradeStatus       NoteTradeStatus   @default(AVAILABLE)
  latitude          Float?
  longitude         Float?
  avmValue          Float?
  avmProvider       String            @default("")
  avmAsOf           DateTime?
  // Tape v2: the servicing record a buyer prices from. All optional, since older tapes and wizard filings lack them.
  loanNumber         String?
  // Months newest first, one character each: 0 paid on time, 1 to 9 months behind, X nothing due.
  payString          String?
  nextDueDate        DateTime?
  servicerName       String?
  modified           Boolean?
  modificationDate   DateTime?
  lossMitigation     String?
  bankruptcyChapter  String?
  bankruptcyFiledAt  DateTime?
  foreclosureFiledAt DateTime?
  // Where the estimated value came from (BPO, AVM, APPRAISAL, SELLER) and when.
  valueType          String?
  valueAsOf          DateTime?
  // PURCHASE, REFINANCE, CASH_OUT, SELLER_FINANCED or BUSINESS.
  loanPurpose        String?
  hoaLien            Boolean?
  taxDelinquent      Boolean?
  // Tape v2.1. An adjustable rate's index, margin and next reset.
  armIndex           String?
  armMargin          Float?
  armNextReset       DateTime?
  // The borrower's credit score as the servicer last pulled it, the model (FICO, VantageScore) and the date.
  creditScore        Int?
  creditScoreType    String?
  creditScoreDate    DateTime?
  // The MERS MIN or eNote ID, and the platform the loan was originated on.
  mersMin            String?
  eNoteId            String?
  originatingPlatform String?
  // Obligations that travel with the loan from an earlier sale, such as agency NPL buyer covenants.
  inheritedCovenants String?
  // Loss mitigation as REQUESTED, OPTIONS_OFFERED or DECIDED, with the outcome in lossMitigation.
  lossMitStage       String?
  // For seller-financed paper: the originator's licence, or why none was needed.
  originatorLicense  String?
  // When a servicer's report last filled the servicing fields, and which servicer.
  servicerSourcedAt  DateTime?
  servicerSource     String?
  // Fields the desk checked against a document: { field: { at, by, source } }. Anything absent is seller-stated.
  verifiedFields     Json?
  inquiries          Inquiry[]
  filings            CourtFiling[]
  collateral         CollateralItem[]
  riskChecks         RiskCheck[]
  discrepancies      FieldDiscrepancy[]
  createdAt          DateTime          @default(now())

  @@index([listingId])
  @@index([state])
  @@index([paymentStatus])
}

model Document {
  id           String   @id @default(cuid()) @map("_id")
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Set when the file belongs to one loan of the listing, such as a desk's O&E report.
  noteId       String?
  type         DocType
  originalName String
  storedName   String
  mime         String
  size         Int
  // The document reader's pass: READ, FAILED or SKIPPED, when, and the stored plain text it extracted.
  readStatus   String?
  readAt       DateTime?
  textKey      String?
  createdAt    DateTime @default(now())
}

model Inquiry {
  id        String        @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  type      InquiryType
  noteId    String?
  note      Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  amount    Float?
  message   String        @default("")
  status    InquiryStatus @default(OPEN)
  messages  OfferMessage[]
  createdAt DateTime      @default(now())
  // The seller's sign-off on this bid's price, when the reserve doesn't already cover it.
  sellerAskedAt        DateTime?
  sellerAskedAmount    Float?
  sellerApprovedAmount Float?
  sellerAnsweredAt     DateTime?
  sellerDeclined       Boolean?
  // The seller's counter, relayed to the buyer. A buyer who accepts it sells at a price the seller already agreed.
  sellerCounterAmount  Float?
  sellerCounteredAt    DateTime?
  // The buyer's good-until date. Past it, the bid can't be awarded and is marked expired.
  expiresAt            DateTime?
  withdrawnAt          DateTime?
  // Placed at the seller's buy-it-now price, which the seller agreed to in advance.
  buyNow               Boolean?
  // A pool bid's price for each loan, as { noteId: dollars }, summing to the bid. Lets the desk take part of the
  // pool when allowPartial is set, and sizes a kick-out.
  loanPrices           Json?
  allowPartial         Boolean?
  // The buying entity this bid is for, when the buyer has more than their main file. Missing means the main file.
  buyerEntityId        String?
  // The seller asked the desk to award this bid, which need not be the one the desk recommended.
  sellerRequestedAt    DateTime?
  // The loans of a pool the seller was asked to approve, for a part-pool sale. Empty means the whole bid.
  sellerAskedNoteIds   String[]      @default([])
  // A losing bidder asked to stand behind the winner, and their answer. A backup bid stays live until backupUntil,
  // and the desk can award it in one step if the winner's closing fails. lib/backup-bids.ts.
  backupAskedAt        DateTime?
  backupAt             DateTime?
  backupDeclinedAt     DateTime?
  backupUntil          DateTime?

  @@index([listingId])
  @@index([buyerId])
}

model CollateralItem {
  id          String           @id @default(cuid()) @map("_id")
  noteId      String
  note        Note             @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind        CollateralKind
  // Order in the chain, for allonges and assignments from the originator to today's holder.
  sequence    Int              @default(0)
  status      CollateralStatus
  // What the desk saw, such as "First Bank to Coastal Capital, recorded 2019".
  detail      String           @default("")
  cureOwner   String           @default("")
  cureBy      DateTime?
  documentId  String?
  recordedAt  DateTime?
  recording   String           @default("")
  // The date written on an allonge or assignment, and when the desk confirmed an allonge is fixed to the note.
  // Courts have refused standing on undated allonges whose attachment can't be shown.
  datedOn     DateTime?
  attachedAt  DateTime?
  // For an endorsement: BLANK, SPECIAL or NONE, and whether the loan number on it matches the note. A photo of the
  // original as received is a document of this listing.
  endorsement     String?
  loanNumberMatch Boolean?
  photoDocumentId String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([noteId])
}

// A dated, multi-seller sale on a fixed cadence: indications by one date, best and final by a later one.
enum SaleEventStatus {
  PLANNED
  INDICATIONS
  BEST_AND_FINAL
  CLOSED
  CANCELED
}

// A device that accepts push notices: a browser's Web Push subscription.
model PushSubscription {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// A buyer who won and didn't close. Enough of them pauses the buyer's bidding until the desk reviews it.
model BuyerStrike {
  id          String    @id @default(cuid()) @map("_id")
  userId      String
  closingId   String
  reason      String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())
  clearedAt   DateTime?
  clearedById String?
  clearNote   String    @default("")

  @@index([userId])
}

model SaleEvent {
  id            String          @id @default(cuid()) @map("_id")
  name          String
  summary       String          @default("")
  // Indications are due by this date; invited bidders then have until bestFinalAt for best and final.
  indicationsAt DateTime
  bestFinalAt   DateTime
  // The rest of the sale calendar, for the process letter. Each is optional; the two dates above are not.
  ndaDueAt        DateTime?
  qaCutoffAt      DateTime?
  awardTargetAt   DateTime?
  closingTargetAt DateTime?
  processNotes    String        @default("")
  status        SaleEventStatus @default(PLANNED)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

// A published agency or HUD loan-sale result, entered by the desk. The GSEs publish cover bids (the
// second-highest bid), not clearing prices, and the label says so.
model AgencySale {
  id             String   @id @default(cuid()) @map("_id")
  program        String
  name           String
  bidDate        DateTime?
  settleBy       DateTime?
  loans          Int?
  upb            Float?
  coverPctUpb    Float?
  coverPctBpo    Float?
  bpoLtv         Float?
  winner         String   @default("")
  sourceUrl      String   @default("")
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([bidDate])
}

model FieldDiscrepancy {
  id            String            @id @default(cuid()) @map("_id")
  noteId        String
  note          Note              @relation(fields: [noteId], references: [id], onDelete: Cascade)
  listingId     String
  field         String
  tapeValue     String            @default("")
  documentValue String            @default("")
  // The document the desk read, such as "Pay history".
  source        String            @default("")
  status        DiscrepancyStatus @default(OPEN)
  sellerNote    String            @default("")
  raisedById    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([listingId])
  @@index([noteId])
}

model RiskCheck {
  id          String     @id @default(cuid()) @map("_id")
  noteId      String
  note        Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind        RiskKind
  result      RiskResult
  detail      String     @default("")
  // Where the desk looked: "PACER", "County tax collector", or a vendor's name.
  source      String     @default("")
  documentId  String?
  checkedById String?
  checkedAt   DateTime   @default(now())

  @@index([noteId])
}

// A bidder's question about a listing. The seller or the desk answers, and a published answer goes to every bidder
// with data-room access, without the asker's name.
model ListingQuestion {
  id           String    @id @default(cuid()) @map("_id")
  listingId    String
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId      String
  asker        User      @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  noteId       String?
  question     String
  answer       String    @default("")
  // OPEN, ANSWERED (published to every bidder) or DECLINED (answered privately or not at all).
  status       String    @default("OPEN")
  answeredById String?
  answeredAt   DateTime?
  // A draft answer the document reader wrote from the room's files, with its sources as JSON. Never shown to buyers
  // until a person edits or accepts it as the answer.
  aiDraft      String?
  aiSources    String?
  aiDraftedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([listingId])
  @@index([askerId])
}

// A change to wire instructions, proposed by one desk member and approved by another before it takes effect.
// closingId empty means the desk's default instructions in settings.
model WireChange {
  id           String    @id @default(cuid()) @map("_id")
  closingId    String?
  closing      Closing?  @relation(fields: [closingId], references: [id], onDelete: Cascade)
  proposedById String
  instructions String
  reason       String    @default("")
  // PENDING, APPROVED or REJECTED.
  status       String    @default("PENDING")
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([closingId])
  @@index([status])
}

// A loan taken out of a closing before settlement, with the price and deposit it took with it.
model ClosingKickout {
  id                String   @id @default(cuid()) @map("_id")
  closingId         String
  closing           Closing  @relation(fields: [closingId], references: [id], onDelete: Cascade)
  noteId            String
  priceCents        Int
  depositCents      Int      @default(0)
  reason            String
  actorId           String
  createdAt         DateTime @default(now())

  @@index([closingId])
}

// A holder's request to delete their account. The desk completes it once nothing open depends on the account.
model DeletionRequest {
  id          String    @id @default(cuid()) @map("_id")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String    @default("")
  // REQUESTED, COMPLETED or REFUSED.
  status      String    @default("REQUESTED")
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String    @default("")

  @@index([status])
  @@index([userId])
}

// A finding the document reader made: a field's value as one document states it, with the words it read.
model AiFinding {
  id          String    @id @default(cuid()) @map("_id")
  listingId   String
  noteId      String?
  documentId  String
  field       String
  value       String
  quote       String    @default("")
  page        Int?
  confidence  Float?
  // PROPOSED, CONFIRMED (the desk agreed and marked the field verified) or REJECTED.
  status      String    @default("PROPOSED")
  decidedById String?
  decidedAt   DateTime?
  // "rules" for the offline reader, or "model:<name>" for a language model.
  source      String
  createdAt   DateTime  @default(now())

  @@index([listingId])
  @@index([documentId])
}

// One run of the reader's accuracy test against the labelled files in tests/fixtures/ai-reading.
model AiEvalRun {
  id        String   @id @default(cuid()) @map("_id")
  source    String
  fields    Int
  correct   Int
  accuracy  Float
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// A seller's request for a valuation of loans they haven't listed. The desk answers with a range and follows up.
model ValuationRequest {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  name      String
  email     String
  company   String   @default("")
  phone     String   @default("")
  loans     Int
  upb       Float
  rows      Json?
  tapeKey   String   @default("")
  tapeName  String   @default("")
  lowPrice  Float?
  highPrice Float?
  basis     String   @default("")
  // NEW, QUOTED, LISTED or CLOSED.
  status    String   @default("NEW")
  listingId String?
  deskNote  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

// A buying entity beyond the buyer's main file: another LLC, a trust, or a self-directed IRA. The desk vets each.
model BuyerEntity {
  id              String             @id @default(cuid()) @map("_id")
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  entityType      InvestorEntity
  jurisdiction    String             @default("")
  // For an IRA: the custodian, and the account title the paper vests in, such as "Custodian FBO Name IRA #1234".
  iraCustodian    String?
  iraAccountTitle String?
  // The last four digits of the entity's EIN. UPB never stores the whole number.
  taxIdLast4      String?
  status          VerificationStatus @default(SUBMITTED)
  reviewerNote    String             @default("")
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([userId])
}

// A market dispatch as it was sent, for the archive.
model DispatchIssue {
  id        String   @id @default(cuid()) @map("_id")
  month     String   @unique
  subject   String
  body      String
  sentAt    DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model NdaAcknowledgment {
  id             String    @id @default(cuid()) @map("_id")
  userId         String
  listingId      String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime  @default(now())
  signerName     String    @default("")
  method         NdaMethod @default(LEGACY)
  signatureKey   String    @default("")
  ipAddress      String    @default("")
  userAgent      String    @default("")
  pdfKey         String    @default("")
  documentId     String    @default("")
  signatureProvider String @default("")
  signatureRef   String    @default("")
  // On a listing whose seller approves each bidder: PENDING until they decide, then APPROVED or DECLINED.
  // Missing means approved, for rooms that open on the NDA alone.
  accessStatus   String?
  accessDecidedAt DateTime?
  accessDecidedById String?
  // After the sale goes to someone else, the bidder is asked to certify they destroyed the room's files.
  destroyRequestedAt DateTime?
  destroyRemindedAt DateTime?
  destroyedAt    DateTime?

  @@unique([userId, listingId])
}

// The seller's side of know-your-customer: who they are and that they may sell the note. Seller impersonation is the
// fastest-growing title fraud, so a listing goes live only once the desk has approved this file.
model SellerProfile {
  userId           String             @id @map("_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType       InvestorEntity     @default(INDIVIDUAL)
  entityName       String             @default("")
  signerName       String             @default("")
  signerTitle      String             @default("")
  idDocKey         String             @default("")
  idDocName        String             @default("")
  idDocMime        String             @default("")
  // Proof the signer may sell: an operating agreement, a resolution, a trust certificate, or for an individual
  // the original note's endorsement to them.
  authorityDocKey  String             @default("")
  authorityDocName String             @default("")
  authorityDocMime String             @default("")
  status           VerificationStatus @default(NOT_STARTED)
  reviewerNote     String             @default("")
  // The last four digits of the seller's EIN or SSN. UPB never stores the whole number.
  taxIdLast4       String?
  // An identity vendor's case, when one is configured. lib/vendors.ts startKyc.
  vendor           String             @default("")
  vendorRef        String             @default("")
  reviewedById     String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  updatedAt        DateTime           @updatedAt
}

model BuyerProfile {
  userId            String             @id @map("_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType        InvestorEntity     @default(INDIVIDUAL)
  entityName        String             @default("")
  jurisdiction      String             @default("")
  accredited        Boolean            @default(false)
  certificationText String             @default("")
  proofKey          String             @default("")
  proofName         String             @default("")
  proofMime         String             @default("")
  // The buyer states the amount. The desk confirms or corrects it, and sets an expiry, when it approves the file.
  proofAmount       Float?
  proofExpiresAt    DateTime?
  proofVerifiedAt   DateTime?
  status            VerificationStatus @default(NOT_STARTED)
  reviewerNote      String             @default("")
  // Asked at onboarding for the federal limit on large single-family investors and state licensing prompts. The
  // buyer's own statement; the desk doesn't verify it.
  homesControlled   Int?
  reoStrategy       String?
  eligibilityAt     DateTime?
  // The last four digits of the buyer's EIN or SSN. UPB never stores the whole number.
  taxIdLast4        String?
  // An approved file is current until this date, set at approval. Past it the buyer re-certifies before bidding
  // again. Missing means the file was approved before re-certification began, and stays current.
  recertifyBy       DateTime?
  recertRemindedAt  DateTime?
  vendor            String             @default("")
  vendorRef         String             @default("")
  submittedAt       DateTime?
  reviewedAt        DateTime?
  updatedAt         DateTime           @updatedAt
}

model OfferMessage {
  id        String           @id @default(cuid()) @map("_id")
  inquiryId String
  inquiry   Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      OfferMessageKind
  amount    Float?
  body      String           @default("")
  createdAt DateTime         @default(now())

  @@index([inquiryId])
}

model Closing {
  id                    String        @id @default(cuid()) @map("_id")
  listingId             String
  listing               Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  inquiryId             String?       @unique
  deskBidId             String?       @unique
  deskBid               DeskBid?      @relation(fields: [deskBidId], references: [id], onDelete: SetNull)
  noteId                String?
  status                ClosingStatus @default(OPEN)
  salePrice             Float
  buyerPremiumCents     Int
  sellerCommissionCents Int
  buyerTotalCents       Int
  netToSellerCents      Int
  provider              String        @default("manual")
  providerRef           String        @default("")
  wireInstructions      String        @default("")
  // The name the buyer takes title in: the investing entity on the buyer file the desk vetted, fixed at award so
  // the papers don't change if the buyer refiles mid-closing. Null for a desk purchase.
  buyerEntity           String?
  buyerEntityId         String?
  // The desk member who runs this closing. Starts as the listing's deal owner.
  deskOwnerId           String?
  // The loans a closing covers when it is part of a pool, or a pool after a kick-out. Empty means noteId alone,
  // or the whole listing when noteId is empty too. lib/closing.ts closingLoans reads it.
  noteIds               String[]      @default([])
  openedAt              DateTime      @default(now())
  closedAt              DateTime?
  canceledAt            DateTime?
  cancelReason          String?
  targetCloseAt         DateTime?
  // Money movement the desk records by hand while escrow is manual. Compared with the expected totals above.
  fundsReceivedCents    Int?
  fundsReceivedAt       DateTime?
  fundsReference        String?
  proceedsSentCents     Int?
  proceedsSentAt        DateTime?
  proceedsReference     String?
  // The deposit set at award and what the desk recorded against it.
  depositCents          Int?
  depositDueAt          DateTime?
  // The end of the buyer's diligence window, when one applies. Until then the buyer may walk away for a finding.
  diligenceEndsAt       DateTime?
  // Whose failure ended a canceled closing: BUYER, SELLER or NEITHER. A buyer's failure records a strike.
  cancelFault           String?
  depositReceivedCents  Int?
  depositReceivedAt     DateTime?
  depositReference      String?
  // Borrower notices. The new owner sends the sale notice (12 CFR 1026.39); UPB only dates and drafts it.
  transferAt            DateTime?
  loanPurpose           String?
  paymentPolicy         String?
  ownerContact          String?
  recordingNote         String?
  ownerNoticeSentAt     DateTime?
  ownerNoticeRemindedAt DateTime?
  // What became of the deposit: HELD, APPLIED, REFUND_DUE, REFUNDED or FORFEITED. Missing means none recorded
  // beyond the fields above. A refund or forfeit is proposed by one desk member and approved by another.
  // lib/deposits.ts.
  depositStatus         String?
  depositProposal       String?
  depositProposedById   String?
  depositProposedAt     DateTime?
  depositResolvedById   String?
  depositResolvedAt     DateTime?
  depositNote           String?
  depositRefundReference String?
  // The stalled-deal backstop's notices, so each goes once. lib/backstop.ts.
  stallWarnedAt         DateTime?
  stallFinalAt          DateTime?
  stallEscalatedAt      DateTime?
  steps                 ClosingStep[]
  signatures            SignatureRequest[]
  boarding              ServicerBoarding?
  funders               ClosingFunder[]
  brokerFees            BrokerFee[]

  @@index([listingId])
  @@index([status])
  kickouts              ClosingKickout[]
  wireChanges           WireChange[]
}

model ClosingStep {
  id          String            @id @default(cuid()) @map("_id")
  closingId   String
  closing     Closing           @relation(fields: [closingId], references: [id], onDelete: Cascade)
  key         ClosingStepKey
  status      ClosingStepStatus @default(PENDING)
  note        String            @default("")
  completedAt DateTime?
  dueAt       DateTime?
  remindedAt  DateTime?
  files       ClosingFile[]

  @@unique([closingId, key])
}

model ClosingFile {
  id           String      @id @default(cuid()) @map("_id")
  stepId       String
  step         ClosingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String
  mime         String
  size         Int
  uploadedById String?
  createdAt    DateTime    @default(now())
}

model ServicerBoarding {
  id           String    @id @default(cuid()) @map("_id")
  closingId    String    @unique
  closing      Closing   @relation(fields: [closingId], references: [id], onDelete: Cascade)
  servicerName String
  // The servicer on the desk's directory, when the buyer picked one from it.
  servicerId   String?
  contactEmail String    @default("")
  loanNumber   String    @default("")
  boardedAt    DateTime?
  // The servicers' transfer letters (12 CFR 1024.33). boardedAt is the effective date they count from.
  goodbyeSentAt DateTime?
  helloSentAt   DateTime?
  notes        String    @default("")
  updatedAt    DateTime  @updatedAt
}

model ServerSession {
  id        String   @id @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RateWindow {
  key       String   @id @map("_id")
  count     Int      @default(0)
  expiresAt DateTime
}

model LoginCode {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model DocumentTemplate {
  key       String   @id @map("_id")
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model ReviewComment {
  id        String       @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  action    ReviewAction
  comment   String       @default("")
  createdAt DateTime     @default(now())

  @@index([listingId])
}

model SavedSearch {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  filters      Json
  alertEnabled Boolean  @default(true)
  // INSTANT, DAILY or WEEKLY. Missing means instant, as before. A daily or weekly search sends one roundup.
  cadence      String?
  lastAlertAt  DateTime?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid()) @map("_id")
  toEmail   String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject   String
  body      String
  delivery  String    @default("log")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toEmail])
  @@index([userId])
}

model RevenueEvent {
  id          String      @id @default(cuid()) @map("_id")
  type        RevenueType
  amountCents Int
  listingId   String?
  userId      String?
  description String
  mock        Boolean     @default(false)
  externalId  String?     @unique
  occurredAt  DateTime    @default(now())
}

model ListingView {
  id        String   @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([userId])
}

enum LeadStatus {
  NEW
  CONTACTED
  LISTING
  PASSED
}

enum DeskBidStatus {
  OPEN
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum HoldingStatus {
  CURRENT
  WATCH
  RESOLVED
}

model BuyBox {
  id            String         @id @default(cuid()) @map("_id")
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  states        String         @default("")
  liens         String         @default("")
  statuses      String         @default("")
  upbMin        Float?
  upbMax        Float?
  priceMin      Float?
  priceMax      Float?
  maxPriceToUpb Float?
  targetYield   Float?
  // The highest loan-to-value the buyer takes, as a percent, and the fewest months since origination.
  maxLtv        Float?
  minSeasoningMonths Int?
  // A standing price rule: every new tape that fits this box gets an indicative bid at once, which the desk
  // reviews and the buyer confirms before it is a bid. Basis UPB prices at bidPercent of UPB; basis YIELD solves
  // for the price that returns targetYield.
  standingBids  Boolean?
  bidBasis      String?
  bidPercent    Float?
  // The most this buyer pays for one loan, whatever the rule says.
  bidCap        Float?
  // For basis SPREAD: the target yield is the 10-year Treasury plus this many percentage points.
  bidSpread     Float?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  matches       ListingMatch[]

  @@index([userId])
}

model ListingMatch {
  id        String   @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyBoxId  String
  buyBox    BuyBox   @relation(fields: [buyBoxId], references: [id], onDelete: Cascade)
  userId    String
  score     Int
  reasons   String   @default("")
  // The box's standing price for this listing, when it has a rule. Indicative only: nothing binds until the
  // buyer confirms it as a bid.
  indicativePrice Float?
  indicativeAt    DateTime?
  // The desk sent the indicative to the buyer to confirm, and when the buyer turned it into a bid or passed.
  invitedAt       DateTime?
  answeredAt      DateTime?
  inquiryId       String?
  // The 10-year rate's date that a spread-based price used, so a stale figure reads as stale.
  rateAsOf        DateTime?
  createdAt DateTime @default(now())

  @@unique([listingId, buyBoxId])
  @@index([listingId])
  @@index([userId])
}

model SellerLead {
  id             String        @id @default(cuid()) @map("_id")
  name           String
  email          String
  phone          String        @default("")
  city           String        @default("")
  state          String
  lienPosition   LienPosition
  paymentStatus  PaymentStatus
  upb            Float
  estimatedValue Float
  interestRate   Float
  monthlyPi      Float
  indicativeLow  Float
  indicativeHigh Float
  basis          String        @default("")
  note           String        @default("")
  status         LeadStatus    @default(NEW)
  userId         String?
  listingId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

