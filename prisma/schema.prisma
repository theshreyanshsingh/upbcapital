model BuyerHolding {
  id                String        @id @default(cuid()) @map("_id")
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  closingId         String?
  listingId         String?
  title             String
  costBasis         Float
  upb               Float
  sharePercent      Float?
  underwrittenYield Float?
  status            HoldingStatus @default(CURRENT)
  acquiredAt        DateTime        @default(now())
  payments          CashReceipt[]   @relation("BuyerReceipts")
  participations    Participation[] @relation("BuyerSlices")

  @@unique([closingId, userId])
  @@index([userId])
}

enum GroupStatus {
  GATHERING
  OFFERED
  COUNTERED
  CLOSING
  CLOSED
  DISSOLVED
}

enum GroupStructure {
  PRO_RATA
  SENIOR_JUNIOR
}

enum PositionSlice {
  PARI
  SENIOR
  JUNIOR
}

enum PositionStatus {
  PLEDGED
  RECONFIRM
  DROPPED
  FUNDED
}

enum FunderStatus {
  PENDING
  FUNDED
}

model GroupBuy {
  id           String          @id @default(cuid()) @map("_id")
  listingId    String
  listing      Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  noteId       String?
  openedById   String
  openedBy     User            @relation("GroupsOpened", fields: [openedById], references: [id], onDelete: Cascade)
  status       GroupStatus     @default(GATHERING)
  minPosition  Float
  deadline     DateTime
  targetAmount Float
  structure    GroupStructure  @default(PRO_RATA)
  seniorYield  Float?
  allowPartial Boolean         @default(false)
  inquiryId    String?         @unique
  closingId    String?         @unique
  positions    GroupPosition[]
  createdAt    DateTime        @default(now())

  @@index([listingId, status])
}

model GroupPosition {
  id        String         @id @default(cuid()) @map("_id")
  groupId   String
  group     GroupBuy       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat      Int
  amount    Float
  percent   Float
  slice     PositionSlice  @default(PARI)
  status    PositionStatus @default(PLEDGED)
  createdAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ClosingFunder {
  id           String        @id @default(cuid()) @map("_id")
  closingId    String
  closing      Closing       @relation(fields: [closingId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float
  premiumCents Int
  percent      Float
  slice        PositionSlice @default(PARI)
  status       FunderStatus  @default(PENDING)
  fundedAt     DateTime?
  // The seat holder's vetted investing entity, fixed when the group's bid is accepted. See Closing.buyerEntity.
  entityName   String?

  @@unique([closingId, userId])
}

model CashReceipt {
  id             String        @id @default(cuid()) @map("_id")
  buyerHoldingId String?
  buyerHolding   BuyerHolding? @relation("BuyerReceipts", fields: [buyerHoldingId], references: [id], onDelete: Cascade)
  deskHoldingId  String?
  deskHolding    DeskHolding?  @relation("DeskReceipts", fields: [deskHoldingId], references: [id], onDelete: Cascade)
  amount         Float
  paidOn         DateTime
  memo           String        @default("")
  // The split a tax export needs. Missing means the holder logged a total only.
  principal      Float?
  interest       Float?
  fees           Float?
  escrow         Float?
  // MANUAL when the holder logged it, or the servicer's name when it came from a servicer report.
  source         String?
  createdAt      DateTime      @default(now())
}

model DeskThread {
  id        String         @id @default(cuid()) @map("_id")
  subject   String
  listingId String?
  inquiryId String?        @unique
  closingId String?        @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   ThreadMember[]
  posts     ThreadPost[]

  @@index([listingId])
}

model ThreadMember {
  id         String     @id @default(cuid()) @map("_id")
  threadId   String
  userId     String
  thread     DeskThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
}

model ThreadPost {
  id        String       @id @default(cuid()) @map("_id")
  threadId  String
  thread    DeskThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime     @default(now())
  files     ThreadFile[]

  @@index([threadId, createdAt])
}

model ThreadFile {
  id           String     @id @default(cuid()) @map("_id")
  postId       String
  post         ThreadPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String
  mime         String
  size         Int
  createdAt    DateTime   @default(now())
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum LossStatus {
  OUTREACH
  REINSTATEMENT
  FORBEARANCE
  MODIFICATION
  FORECLOSURE
  REO
  RESOLVED
}

enum PlanKind {
  REINSTATEMENT
  FORBEARANCE
  MODIFICATION
}

enum ExitPath {
  RESALE
  RENTAL
}

enum SliceStatus {
  DRAFT
  LISTED
  SOLD
}

model LossCase {
  id           String                  @id @default(cuid()) @map("_id")
  holdingId    String                  @unique
  holding      DeskHolding             @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  status       LossStatus              @default(OUTREACH)
  summary      String                  @default("")
  outreach     LossOutreach[]
  plans        LossPlan[]
  milestones   ForeclosureMilestone[]
  tasks        LossTask[]
  property     ReoProperty?
  updatedAt    DateTime                @updatedAt
}

model LossOutreach {
  id          String   @id @default(cuid()) @map("_id")
  caseId      String
  case        LossCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contactedAt DateTime
  channel     String   @default("phone")
  note        String
  createdAt   DateTime @default(now())
}

model LossPlan {
  id        String   @id @default(cuid()) @map("_id")
  caseId    String
  case      LossCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      PlanKind
  amount    Float
  months    Int      @default(0)
  rate      Float                     @default(0)
  startOn   DateTime?
  note      String   @default("")
  createdAt DateTime @default(now())
}

model ForeclosureMilestone {
  id        String    @id @default(cuid()) @map("_id")
  caseId    String
  case      LossCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  label     String
  attorney  String    @default("")
  courtDate DateTime?
  filedOn   DateTime?
  note      String    @default("")
  doneAt    DateTime?
}

model LossTask {
  id     String    @id @default(cuid()) @map("_id")
  caseId String
  case   LossCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title  String
  dueOn      DateTime
  doneAt     DateTime?
  remindedAt DateTime?

  @@index([dueOn])
}

model ReoProperty {
  id           String   @id @default(cuid()) @map("_id")
  caseId       String   @unique
  case         LossCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  address      String
  rehabBudget  Float
  exitPath     ExitPath
  exitValue    Float                     @default(0)
  monthlyRent  Float                     @default(0)
  note         String   @default("")
  createdAt    DateTime @default(now())
}

model Participation {
  id              String        @id @default(cuid()) @map("_id")
  deskHoldingId   String?
  deskHolding     DeskHolding?  @relation("DeskSlices", fields: [deskHoldingId], references: [id], onDelete: Cascade)
  buyerHoldingId  String?
  buyerHolding    BuyerHolding? @relation("BuyerSlices", fields: [buyerHoldingId], references: [id], onDelete: Cascade)
  listingId       String?
  percent         Float
  paymentCount    Int?
  price           Float
  status          SliceStatus   @default(DRAFT)
  createdAt       DateTime      @default(now())
}

model Investor {
  id          String              @id @default(cuid()) @map("_id")
  name        String
  email       String
  entity      String              @default("")
  commitments Commitment[]
  allocations CapitalAllocation[]
  createdAt   DateTime            @default(now())
}

model Commitment {
  id         String   @id @default(cuid()) @map("_id")
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount     Float
  note       String   @default("")
  committedOn DateTime @default(now())
}

model CapitalAllocation {
  id            String      @id @default(cuid()) @map("_id")
  investorId    String
  investor      Investor    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  holdingId     String
  holding       DeskHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  amount        Float
  createdAt     DateTime    @default(now())

  @@index([holdingId])
  @@index([investorId])
}

model StateDisclosure {
  state     String   @id @map("_id")
  license   String   @default("")
  body      String
  updatedAt DateTime @updatedAt
}

model OfacCheck {
  id           String    @id @default(cuid()) @map("_id")
  name         String
  result       String
  provider     String    @default("mock")
  createdAt    DateTime  @default(now())
  context      String?
  detail       String?
  matched      String?
  userId       String?
  listingId    String?
  // OPEN, CLEARED, or CONFIRMED on a REVIEW result. Rows from before this field count as OPEN.
  status       String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([name])
  @@index([result, createdAt])
  @@index([userId])
  @@index([listingId])
}

model PageHit {
  id        String   @id @default(cuid()) @map("_id")
  path      String
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

model UnitCost {
  id        String @id @default(cuid()) @map("_id")
  trade     String
  unit      String
  costCents Int
  region    String @default("South Florida")

  @@unique([region, trade, unit])
}

model RehabEstimate {
  id            String          @id @default(cuid()) @map("_id")
  holdingId     String          @unique
  holding       DeskHolding     @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  arv           Float         @default(0)
  holdingMonths Int             @default(6)
  monthlyHold   Float         @default(2500)
  monthlyRent   Float         @default(0)
  expenseRatio  Float         @default(35)
  exitPath      ExitPath        @default(RESALE)
  lines         RehabLine[]
  bids          ContractorBid[]
  draws         RehabDraw[]
  updatedAt     DateTime        @updatedAt
}

model RehabLine {
  id           String        @id @default(cuid()) @map("_id")
  estimateId   String
  estimate     RehabEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  room         String        @default("")
  trade        String
  quantity     Float
  unitCostCents Int
  note         String        @default("")

  @@index([estimateId])
}

model ContractorBid {
  id         String        @id @default(cuid()) @map("_id")
  estimateId String
  estimate   RehabEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  contractor String
  amount     Float
  days       Int           @default(0)
  note       String        @default("")
  selected   Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([estimateId])
}

model RehabDraw {
  id         String        @id @default(cuid()) @map("_id")
  estimateId String
  estimate   RehabEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  label      String
  percent    Float
  fundedAt   DateTime?

  @@index([estimateId])
}

enum FilingStatus {
  NEW
  CONTACTED
  LISTING
  PASSED
}

model CourtFiling {
  id          String       @id @default(cuid()) @map("_id")
  county      String
  caseNumber  String
  filedOn     DateTime?
  defendant   String       @default("")
  plaintiff   String       @default("")
  street      String       @default("")
  city        String       @default("")
  state       String       @default("FL")
  zip         String       @default("")
  noteId      String?
  note        Note?        @relation(fields: [noteId], references: [id], onDelete: SetNull)
  status      FilingStatus @default(NEW)
  outreach    String       @default("")
  createdAt   DateTime     @default(now())

  @@unique([county, caseNumber])
  @@index([status])
  @@index([noteId])
}

model Post {
  id          String    @id @default(cuid()) @map("_id")
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id        String  @id @default(cuid()) @map("_id")
  quote     String
  role      String
  place     String  @default("")
  published Boolean @default(true)
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid()) @map("_id")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([prefix])
}

model WebhookEndpoint {
  id         String            @id @default(cuid()) @map("_id")
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  events     String            @default("offer.created,offer.accepted,offer.declined,offer.countered")
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id         String          @id @default(cuid()) @map("_id")
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  status     Int             @default(0)
  detail     String          @default("")
  // The signed body, kept so a failed delivery can be retried as sent.
  payload    String          @default("")
  attempts   Int             @default(1)
  // When the next retry is due. Missing once it was delivered or gave up.
  nextAttemptAt DateTime?
  deliveredAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([endpointId])
  @@index([nextAttemptAt])
}

model TapeDraft {
  token     String   @id @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model JobRun {
  id         String    @id @default(cuid()) @map("_id")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    String    @default("")
}

// One row per buyer each time the desk sends them a listing or a bid deadline.
model ListingSend {
  id        String   @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentById  String?
  // LISTING or DEADLINE
  kind      String
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([userId])
}

// Desk-only notes on a listing or closing. Never shown to a party.
model DeskNote {
  id          String   @id @default(cuid()) @map("_id")
  // listing or closing today; the action also accepts user
  subjectType String
  subjectId   String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([authorId])
}

model AuditEvent {
  id         String   @id @default(cuid()) @map("_id")
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}

// A document sent for signature on a closing, and where each signer stands. In-app signing records the typed name,
// the time and the request it came from; a vendor envelope reports back through /api/esign/webhook. lib/signatures.ts.
model SignatureRequest {
  id           String    @id @default(cuid()) @map("_id")
  closingId    String
  closing      Closing   @relation(fields: [closingId], references: [id], onDelete: Cascade)
  // The form, as a template key from lib/templates.ts: PSA, ASSIGNMENT, ALLONGE and the rest.
  kind         String
  // in_app, dropbox-sign or docusign.
  provider     String    @default("in_app")
  providerRef  String    @default("")
  // SENT, PARTIAL, SIGNED, DECLINED, VOIDED or EXPIRED.
  status       String    @default("SENT")
  // [{ role: "BUYER" | "SELLER" | "FUNDER" | "DESK", userId?, name, email, signedAt?, signedName?, ip?, declinedAt? }]
  signers      Json
  // SHA-256 of the PDF as sent, so a signed copy can be matched to what each party saw.
  documentHash String    @default("")
  dueAt        DateTime?
  sentAt       DateTime  @default(now())
  completedAt  DateTime?
  remindedAt   DateTime?
  voidedAt     DateTime?
  voidReason   String?
  createdById  String?

  @@index([closingId])
  @@index([status, dueAt])
}

// A person who owns 25% or more of a buying entity, or controls it, as FinCEN's customer due diligence rule asks.
// Each is screened against the sanctions list. lib/beneficial-owners.ts.
model BeneficialOwner {
  id            String    @id @default(cuid()) @map("_id")
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The entity owned: one of the buyer's BuyerEntity rows, or the buyer's main file when null.
  buyerEntityId String?
  name          String
  title         String    @default("")
  ownershipPct  Float?
  controlPerson Boolean   @default(false)
  country       String    @default("US")
  // CLEAR, REVIEW or MATCH from the last sanctions screen, and when it ran.
  screenResult  String?
  screenedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// A standing agreement a member signs once: the master purchase agreement for buyers, the master sale agreement for
// sellers. Each sale's papers incorporate it by reference. A new version needs a new acceptance. lib/agreements.ts.
model AgreementAcceptance {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // MASTER_PURCHASE or MASTER_SALE.
  kind        String
  version     String
  signerName  String
  signerTitle String   @default("")
  entityName  String   @default("")
  ip          String   @default("")
  userAgent   String   @default("")
  acceptedAt  DateTime @default(now())

  @@index([userId, kind])
}

// A loan servicer on the desk's directory: who can board a purchased loan, in which states, and whether UPB reads
// their exports. The desk enters every field. lib/servicers.ts.
model Servicer {
  id           String   @id @default(cuid()) @map("_id")
  name         String   @unique
  website      String   @default("")
  contactEmail String   @default("")
  states       String[] @default([])
  // A format key from lib/servicer-import.ts when UPB reads this servicer's export.
  importFormat String?
  boardingFee  String   @default("")
  monthlyFee   String   @default("")
  notes        String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
