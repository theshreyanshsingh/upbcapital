# MongoDB. Locally this matches docker-compose.yml (a one-node replica set).
# In production use the Atlas URL for UPB's own database, for example
# mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/upb_capital?retryWrites=true&w=majority
# Never point it at the synergifund database. Release builds refuse that name.
DATABASE_URL="mongodb://localhost:27017/upb_capital?directConnection=true"

# Required in production. A long random string (`openssl rand -base64 32`). Signs the session cookie.
# The value below is the local demo secret. The production build rejects it.
AUTH_SECRET="dev-only-upb-capital-secret-change-me-1847"

# Production only. The Vercel build creates this admin once. It does not reset the password later.
# Do not use a @upbcapital.test address or the demo password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Public origin. Production must be https. Stripe success URLs and links in mail use it.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:4317"
# Only for an internal server reached over plain http (pm2 on a port, no proxy): lets sign-in cookies work without https.
# Release builds refuse it.
# ALLOW_HTTP_SESSIONS="1"

# Stripe. Leave the secret blank to keep simulated Pro checkout.
# When the secret is set, saving the Pro price on the fee schedule creates
# the Stripe Price and stores its id. STRIPE_PRO_PRICE_ID is only a fallback.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Optional shared desk inbox. Desk alerts (new listings, broker files, offers, sign-ups,
# verification, deadlines) go to every approved admin, and also here when set.
# The public footer shows it. The value below is the demo inbox. The production build rejects it.
DESK_EMAIL="iris@upbcapital.test"

# Mail. Resend wins when both are set. Otherwise SMTP. Otherwise the log.
RESEND_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# File storage. Local disk is fine for this machine. Production on Vercel must set one of the two.
# Cloudflare R2 (S3 API): bucket name, account API token, and
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
# Vercel Blob: create a private store. Vercel adds BLOB_READ_WRITE_TOKEN. S3 wins if both are set.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Folder for UPB's files in a bucket shared with another app, e.g. "upb-capital". Blank writes at the bucket root.
S3_PREFIX=""
BLOB_READ_WRITE_TOKEN=""

# Escrow. "manual" issues wire instructions the desk can edit.
# Register another provider with registerEscrowProvider() and set its id here.
ESCROW_PROVIDER="manual"

# AVM. "mock" pins a city. "attom" calls ATTOM when ATTOM_API_KEY is set, and falls back to mock.
AVM_PROVIDER="mock"
ATTOM_API_KEY=""

# Shared limits. database (default), redis (needs REDIS_URL), or memory.
RATE_LIMIT_STORE="database"
REDIS_URL=""

# E-sign. Leave blank to keep the in-app signature.
DROPBOX_SIGN_API_KEY=""
DROPBOX_SIGN_TEST_MODE="1"
DOCUSIGN_ACCESS_TOKEN=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_BASE_URL="https://demo.docusign.net/restapi"

# KYC. Leave blank to keep the desk form. Webhook header is x-kyc-secret.
PERSONA_API_KEY=""
PERSONA_TEMPLATE_ID=""
PARALLEL_API_KEY=""
KYC_WEBHOOK_SECRET=""

# OFAC. Screens against Treasury's free SDN list and its aliases, read at most every six hours.
# Left blank, the desk uses a seven-name stand-in that is not real screening. Release builds refuse that.
# OFAC_SDN_URL="https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV"
OFAC_SDN_URL=""
# A paid vendor instead. When both are set, the desk fetches the URL and parses JSON names or an OpenSanctions-style body.
OFAC_API_KEY=""
OFAC_API_URL=""

# Required in production. `openssl rand -base64 32`.
# vercel.json calls GET /api/cron daily. Vercel sends this value as Authorization: Bearer.
CRON_SECRET=""

# Desk assistant. Leave the key blank to keep the local sketch.
# Any OpenAI-compatible chat completions endpoint works.
LLM_API_KEY=""
OPENAI_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
